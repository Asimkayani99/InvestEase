@page "/events/{Id:int}"
@inject EventService Service

<PageTitle>EventEase — Event Details</PageTitle>

@if (ev is null)
{
    @* Friendly handling of a bad route value instead of a crash:
       this is the routing-error fix — validate the parameter and guide the user back. *@
    <h1>Event not found</h1>
    <p class="text-danger">No event exists with ID @Id. It may have been deleted.</p>
    <a class="btn btn-primary" href="/events">Back to events</a>
}
else
{
    <h1>@ev.Title</h1>
    <div class="col-md-6">
        <EventCard Event="ev" ShowActions="false" />
    </div>
    <p class="mt-3">
        This page is reached through the route <code>/events/{Id:int}</code> —
        the <code>:int</code> constraint means non-numeric URLs never reach this page.
    </p>
    <a class="btn btn-secondary" href="/events">Back to events</a>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Event? ev;

    protected override void OnParametersSet() => ev = Service.GetById(Id);
}
